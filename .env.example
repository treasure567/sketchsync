# Docker Compose settings. Copy to `.env` and edit. Only needed on the VPS;
# local runs work with the defaults.

# Strong password for the bundled Postgres (set before the first start).
POSTGRES_PASSWORD=change-me

# Public domain, used by `docker compose --profile https up` (Caddy gets the
# TLS certificate automatically). Point the domain's DNS A record at the VPS.
DOMAIN=sketchsync.example.com

# Where the web container listens. With the https profile, bind it to
# 127.0.0.1 so only Caddy can reach it.
WEB_BIND=127.0.0.1
WEB_PORT=8080
