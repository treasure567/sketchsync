{
  "name": "@sketchsync/server",
  "private": true,
  "version": "0.1.0",
  "description": "SketchSync collaboration and storage server",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "seed:dev": "node scripts/seed-dev.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  }
}
